# TakeoffPro AI provider configuration
# Copy this file to .env and fill in the values you need.
# Never commit a .env file that contains real API keys.

# ---------------------------------------------------------------------------
# Provider selection — cascade priority
# ---------------------------------------------------------------------------
# Primary:    openai      (OpenAI API key — Codex OAuth not available for desktop apps)
# Backup:     deepseek    (DeepSeek API — automatically used when OpenAI is unavailable)
# Last resort: lmstudio   (local, no key required)
#
# Set AI_PROVIDER to your preferred primary. DeepSeek backup activates whenever
# DEEPSEEK_API_KEY is set, regardless of AI_PROVIDER value.
AI_PROVIDER=openai

# ---------------------------------------------------------------------------
# LM Studio (local, no API key required)
# ---------------------------------------------------------------------------
# Base URL shown in the LM Studio "Local Server" panel.
AI_BASE_URL=http://127.0.0.1:1234/v1

# Any non-empty string works; many OpenAI-compatible clients require a key field.
AI_API_KEY=lm-studio-local

# Model IDs reported by GET /v1/models in LM Studio.
# Leave blank to auto-select the first loaded model.
AI_TAKEOFF_MODEL=
AI_CHAT_MODEL=

# Embedding model for RAG/document chat (if supported by the loaded model).
AI_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
AI_TAKEOFF_ENABLED=true

# Default ceiling height used when architectural drawings do not note one.
DEFAULT_CEILING_HEIGHT_FT=9

# ---------------------------------------------------------------------------
# Cloud providers (optional — only needed when AI_PROVIDER=openai or anthropic)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# DeepSeek (backup provider — used automatically when OpenAI is unavailable)
# ---------------------------------------------------------------------------
# Get your key at platform.deepseek.com.
# Note: DeepSeek does not support image/vision input on its public API;
# PDF text extraction is used in place of page images.
DEEPSEEK_API_KEY=
# Override the default model (deepseek-chat = DeepSeek-V3).
DEEPSEEK_MODEL=deepseek-chat
